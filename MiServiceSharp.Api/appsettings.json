{
  "MiService": {
    "TokenFile": "./data/.mi.token.json"
  },
  "Security": {
    "ApiKey": "change-this-api-key",
    "JwtIssuer": "MiServiceSharp.Api",
    "JwtAudience": "MiServiceSharp.Client",
    "JwtSigningKey": "change-this-super-long-jwt-signing-key-1234567890",
    "JwtExpireMinutes": 120
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}